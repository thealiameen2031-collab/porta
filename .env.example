# Optional: enable the generative learning-plan coach with an OpenAI-compatible API.
# Leave unset to use the local ML matcher without sending data to an AI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Copy this file to .env, fill in the settings you use, then restart Porta.
# .env is loaded automatically and is ignored by git; never commit credentials.

# Password reset emails via SMTP over TLS.
# Gmail SMTP. Create a Google App Password (requires 2-Step Verification)
# and put it in PORTA_SMTP_PASSWORD; do not use the normal Gmail password.
PORTA_SMTP_HOST=smtp.gmail.com
# Use port 465 (implicit TLS) or 587 (STARTTLS).
PORTA_SMTP_PORT=465
PORTA_SMTP_FROM=thealiameen2031@gmail.com
PORTA_SMTP_USERNAME=thealiameen2031@gmail.com
PORTA_SMTP_PASSWORD=
PORTA_PUBLIC_URL=http://localhost:8000

# WhatsApp account verification through Meta WhatsApp Cloud API.
# The Meta Phone Number ID must belong to Porta's WhatsApp Business sender
# (+974 66409227); it is not the same as the displayed phone number.
PORTA_WHATSAPP_PHONE_NUMBER_ID=
PORTA_WHATSAPP_ACCESS_TOKEN=
PORTA_WHATSAPP_TEMPLATE_NAME=porta_verification_code
PORTA_WHATSAPP_TEMPLATE_LANGUAGE=en_US
PORTA_WHATSAPP_API_VERSION=v22.0

# Optional: Google and LinkedIn OpenID Connect sign-in.
# Register the matching callback URL exactly as shown with each provider.
# http://localhost:8000/api/auth/google/callback
# http://localhost:8000/api/auth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PORTA_SESSION_SECRET=
# Set true in production when Porta is served over HTTPS.
PORTA_COOKIE_SECURE=false

# Defaults to data/porta.sqlite3
# PORTA_DB_PATH=data/porta.sqlite3
